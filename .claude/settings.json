{
  "permissions": {
    "allow": [
      "Bash(python tools/*)",
      "Bash(python3 tools/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git push -u origin *)",
      "Bash(npm run *)",
      "Bash(npx *)",
      "Bash(composer *)",
      "Bash(php *)",
      "Bash(vendor/bin/*)",
      "Edit",
      "Write",
      "mcp__github__pull_request_read",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__merge_pull_request",
      "mcp__github__get_job_logs",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__actions_run_trigger",
      "mcp__github__list_pull_requests",
      "mcp__github__list_issues",
      "mcp__github__issue_read",
      "mcp__github__add_issue_comment"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/continue_batch.py\"", "timeout": 90}
        ]
      }
    ]
  }
}
