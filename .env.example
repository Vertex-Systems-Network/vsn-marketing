APP_NAME="VSN Marketing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Enterprise OIDC remains disabled until a non-production origin, pinned signing key,
# explicit subject binding, and provider interoperability review are approved.
ENTERPRISE_OIDC_ENABLED=false
ENTERPRISE_OIDC_WORKSPACE_ID=
ENTERPRISE_OIDC_ISSUER=
ENTERPRISE_OIDC_CLIENT_ID=
ENTERPRISE_OIDC_CLIENT_SECRET=
ENTERPRISE_OIDC_REDIRECT_URI=
# Local development only. Never enable outside APP_ENV=local.
ENTERPRISE_OIDC_LOCAL_HTTP_CALLBACK=false
ENTERPRISE_OIDC_KEY_ID=
ENTERPRISE_OIDC_PUBLIC_KEY_PEM_BASE64=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vsn_marketing
DB_USERNAME=vsn
DB_PASSWORD=vsn
DB_SSLMODE=prefer

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_LOCK_DB=3
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5

OPERATIONS_TOKEN=

HORIZON_MAX_PROCESSES=3

DELIVERY_ADMISSION_CONCURRENCY_ENABLED=true
DELIVERY_ADMISSION_GLOBAL_CONCURRENCY_LIMIT=
DELIVERY_ADMISSION_WORKSPACE_CONCURRENCY_LIMIT=
DELIVERY_ADMISSION_RESERVATION_TTL_SECONDS=

DELIVERY_RECOVERY_RETRY_BASE_DELAY_SECONDS=5
DELIVERY_RECOVERY_RETRY_MAX_DELAY_SECONDS=300
DELIVERY_RECOVERY_BREAKER_FAILURE_THRESHOLD=3
DELIVERY_RECOVERY_BREAKER_OPEN_SECONDS=60
DELIVERY_RECOVERY_RECONCILIATION_MAX_PROBES=3

FILESYSTEM_DISK=s3
OBJECT_STORE_DISK=s3
AWS_ACCESS_KEY_ID=vsn
AWS_SECRET_ACCESS_KEY=vsn-development-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=vsn-marketing
AWS_URL=
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

OUTBOX_QUEUE=outbox
OUTBOX_BATCH_SIZE=100
OUTBOX_SCAN_LOCK_SECONDS=55

VITE_APP_NAME="${APP_NAME}"

# ADR-0006 EU-only residency attestations (leave unset to fail closed)
RESIDENCY_DATABASE_REGION=
RESIDENCY_QUEUE_REGION=
RESIDENCY_FILES_REGION=
RESIDENCY_LOGS_REGION=
RESIDENCY_BACKUPS_REGION=
RESIDENCY_ANALYTICS_REGION=
RESIDENCY_AI_EGRESS_REGION=
RESIDENCY_PROVIDER_EGRESS_REGION=
