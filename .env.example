APP_NAME="VSN Marketing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=vsn_marketing
DB_USERNAME=vsn
DB_PASSWORD=vsn
DB_SSLMODE=prefer

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_FAILED_DRIVER=database-uuids
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_LOCK_DB=3
REDIS_QUEUE_CONNECTION=queue
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=120
REDIS_QUEUE_BLOCK_FOR=5

HORIZON_MAX_PROCESSES=3

FILESYSTEM_DISK=s3
OBJECT_STORE_DISK=s3
AWS_ACCESS_KEY_ID=vsn
AWS_SECRET_ACCESS_KEY=vsn-development-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=vsn-marketing
AWS_URL=
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

OUTBOX_QUEUE=outbox
OUTBOX_BATCH_SIZE=100
OUTBOX_SCAN_LOCK_SECONDS=55

VITE_APP_NAME="${APP_NAME}"
