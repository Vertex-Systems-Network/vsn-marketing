{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "vertex-systems-network/vsn-marketing",
  "type": "project",
  "description": "AI-native provider-agnostic marketing operating system.",
  "license": "GPL-3.0-only",
  "require": {
    "php": "^8.3",
    "inertiajs/inertia-laravel": "^3.0",
    "laravel/framework": "^13.17",
    "laravel/horizon": "^5.48",
    "laravel/tinker": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.9",
    "laravel/pail": "^1.2",
    "laravel/pint": "^1.27",
    "laravel/sail": "^1.53",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "post-root-package-install": ["@php -r \"file_exists('.env') || copy('.env.example', '.env');\""],
    "post-create-project-cmd": ["@php artisan key:generate --ansi"],
    "test": "@php artisan test",
    "lint": "pint --parallel",
    "lint:check": "pint --parallel --test",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {"php": "8.3.0"},
    "allow-plugins": {"pestphp/pest-plugin": true}
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
